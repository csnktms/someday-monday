{
  "name": "someday-monday",
  "version": "0.2.0",
  "private": true,
  "description": "Landing page for Someday Monday: a React app (Vite) with a tiny Node.js server.",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
