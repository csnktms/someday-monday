  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
